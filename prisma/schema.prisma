//  Description: Defines the Prisma data model for Argent, describing database entities, relationships,
//  defaults, and generated client configuration.
//  Last changed by hilario on 30 May 2026 at 19:35.
//
generator client {
    provider = "prisma-client"
    output   = "../lib/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id                      String                  @id @default(cuid())
    name                    String
    email                   String                  @unique
    password                String
    dateOfBirth             String
    recoveryEmail           String?
    role                    String                  @default("user")
    avatar                  String?
    status                  String                  @default("active")
    suspendedAt             DateTime?
    suspendedReason         String?
    lastLoginAt             DateTime?
    lastLoginIp             String?
    resetToken              String?                 @unique
    resetTokenExpiry        DateTime?
    sessionVersion          Int                     @default(0)
    emailVerified           Boolean                 @default(false)
    emailTwoFactorEnabled   Boolean                 @default(false)
    emailTwoFactorCode      String?
    emailTwoFactorCodeExpiry DateTime?
    saltEdgeCustomerId      String?                 // @unique
    createdAt               DateTime                @default(now())
    updatedAt               DateTime                @updatedAt
    
    auditLogsPerformed      AuditLog[]              @relation("AuditPerformer")
    auditLogs               AuditLog[]
    bankAccounts            BankAccount[]
    bills                   Bill[]
    budgets                 Budget[]
    counterparties          Counterparty[]
    financialGoalAccounts   FinancialGoalAccount[]
    financialGoals          FinancialGoal[]
    notifications           Notification[]
    oauthAccounts           OAuthAccount[]
    PACERules               PACERule[]
    rules                   Rule[]
    saltEdgeConnections     SaltEdgeConnection[]
    spreadsheetDocuments    SpreadsheetDocument[]
    spreadsheetLogs         SpreadsheetLog[]        @relation("SpreadsheetLogs")
    tags                    Tag[]
    transactions            Transaction[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model SaltEdgeConnection {
  id             String        @id @default(cuid())
  userId         String
  customerId     String
  connectionId   String        @unique
  providerCode   String
  providerName   String
  countryCode    String        @default("PT")
  status         String        @default("active")
  lastSyncAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accounts       BankAccount[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customerId])
}

model BankAccount {
  id                String              @id @default(cuid())
  userId            String
  connectionId      String?
  saltEdgeAccountId String?             @unique
  bankId            String
  accountType       String              @default("checking")
  cardName          String
  iban              String?
  currency          String              @default("EUR")
  balance           Decimal             @default(0) @db.Decimal(20, 2)
  color             String              @default("#3B82F6")
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  bank              Bank                @relation(fields: [bankId], references: [id])
  connection        SaltEdgeConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bills             Bill[]
  financialGoals    FinancialGoal[]
  transactions      Transaction[]

  @@index([userId])
  @@index([connectionId])
}

model Bank {
  id       String        @id @default(cuid())
  name     String        @unique
  accounts BankAccount[]
}

model Transaction {
  id              String        @id @default(cuid())
  userId          String
  saltEdgeId      String?       @unique
  date            DateTime      @db.Date
  type            String
  amount          Decimal       @db.Decimal(20, 2)
  description     String
  tags            String[]
  accountId       String
  counterpartyId  String?
  counterpartyRaw String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  account         BankAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty    Counterparty? @relation(fields: [counterpartyId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date(sort: Desc)])
  @@index([userId, type])
  @@index([userId, accountId])
  @@index([userId, accountId, date(sort: Desc)])
  @@index([userId, counterpartyId])
  @@index([accountId])
  @@index([tags], type: Gin)
}

model Bill {
  id             String        @id @default(cuid())
  userId         String
  name           String
  amount         Decimal       @db.Decimal(20, 2)
  tags           String[]
  dueDay         Int
  frequency      String
  accountId      String
  category       String
  autopay        Boolean       @default(false)
  status         String        @default("pending")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  account        BankAccount   @relation(fields: [accountId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([accountId])
}

model Budget {
  id             String        @id @default(cuid())
  userId         String
  tag            String
  category       String
  limit          Decimal       @db.Decimal(20, 2)
  color          String        @default("#6366f1")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, tag])
}

model FinancialGoal {
  id             String                 @id @default(cuid())
  userId         String
  accountId      String?
  name           String
  targetAmount   Decimal                @db.Decimal(20, 2)
  currentAmount  Decimal                @default(0) @db.Decimal(20, 2)
  baselineAmount Decimal                @default(0) @db.Decimal(20, 2)
  targetMode     String                 @default("total")
  deadline       DateTime?              @db.Date
  category       String                 @default("savings")
  color          String                 @default("#6366f1")
  status         String                 @default("active")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  accountLinks   FinancialGoalAccount[]
  bankAccount    BankAccount?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, accountId])
  @@index([userId, status])
}

model FinancialGoalAccount {
  id                String        @id @default(cuid())
  userId            String
  goalId            String
  name              String
  balance           Decimal       @default(0) @db.Decimal(20, 2)
  currency          String        @default("EUR")
  status            String        @default("active")
  transferReference String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal              FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId])
  @@index([userId])
}

model Notification {
  id             String        @id @default(cuid())
  userId         String
  title          String
  message        String
  type           String
  read           Boolean       @default(false)
  actionUrl      String?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
}

model Tag {
  id             String        @id @default(cuid())
  userId         String
  slug           String
  name           String
  color          String        @default("#6366f1")
  icon           String        @default("tag")
  isSystem       Boolean       @default(false)
  isArchived     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, slug])
}

model Counterparty {
  id             String        @id @default(cuid())
  userId         String
  normalizedKey  String
  displayName    String
  cachedTagSlug  String?
  cachedSource   String?
  cachedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@index([userId])
  @@index([userId, normalizedKey])
}

model Rule {
  id             String        @id @default(cuid())
  userId         String
  name           String
  enabled        Boolean       @default(true)
  filters        Json
  addTagSlugs    String[]
  priority       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled, priority(sort: Desc)])
}

model PACERule {
  id             String        @id @default(cuid())
  userId         String
  pattern        String
  matchField     String        @default("description")
  tag            String
  priority       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, priority(sort: Desc)])
}

model SpreadsheetDocument {
  id             String           @id @default(cuid())
  userId         String
  name           String
  description    String?
  sheetType      String           @default("manual")
  linkedEntity   String?
  content        Json
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs           SpreadsheetLog[]

  @@index([userId])
  @@index([sheetType])
}

model SpreadsheetLog {
  id            String              @id @default(cuid())
  spreadsheetId String
  userId        String
  action        String
  summary       String?
  createdAt     DateTime            @default(now())
  spreadsheet   SpreadsheetDocument @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)
  user          User                @relation("SpreadsheetLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([spreadsheetId, createdAt(sort: Desc)])
  @@index([userId])
}

model AuditLog {
  id           String   @id @default(cuid())
  performerId  String
  targetUserId String?
  action       String
  entity       String
  entityId     String?
  details      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())
  performer    User     @relation("AuditPerformer", fields: [performerId], references: [id], onDelete: Cascade)
  targetUser   User?    @relation(fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([performerId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model SystemAnnouncement {
  id        String    @id @default(cuid())
  title     String
  message   String
  type      String    @default("info")
  isActive  Boolean   @default(true)
  startsAt  DateTime  @default(now())
  expiresAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, startsAt, expiresAt])
}
