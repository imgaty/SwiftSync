# Argent environment variables
# Copy this file to .env and replace placeholder values. Never commit real secrets.

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/argent"

# Security
# SESSION_SECRET is preferred. AUTH_SECRET and NEXTAUTH_SECRET are accepted fallbacks.
SESSION_SECRET="generate-a-random-64-character-hex-string"
# AUTH_SECRET="generate-a-random-64-character-hex-string"
# NEXTAUTH_SECRET="generate-a-random-64-character-hex-string"

PASSWORD_PEPPER_ACTIVE="p1"
PASSWORD_PEPPER_P1="generate-a-random-64-character-hex-string"
# PASSWORD_PEPPER_P2="generate-a-random-64-character-hex-string"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# APP_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Argent <onboarding@resend.dev>"
# RESEND_DEV_TO_EMAIL="dev-recipient@example.com"

# Banking API (Salt Edge)
SALT_EDGE_APP_ID="your_salt_edge_app_id"
SALT_EDGE_SECRET="your_salt_edge_secret"
# SALT_EDGE_BASE_URL="https://www.saltedge.com/api/v6"

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Proxy and rate limiting
# TRUSTED_CLIENT_IP_HEADER="x-forwarded-for"

# Local debugging and scripts
# PRISMA_LOG_QUERIES="1"
# BASE_URL="http://localhost:3000"
# LOGIN_EMAIL="user@example.com"
# LOGIN_PASSWORD="password"
# LOGIN_2FA_CODE="000000"
