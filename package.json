{
    "name": "argent",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.24.0",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --cache --cache-location .next/cache/eslint/",
        "lint:fix": "eslint . --fix --cache --cache-location .next/cache/eslint/",
        "check": "npm run typecheck && npm run lint",
        "test:auth-security": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON lib/auth-security.test.mjs",
        "test:password": "node --conditions react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON lib/password.test.mjs",
        "test:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON lib/data-import.test.mjs",
        "test:dashboard": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON components/dashboard/dashboard-priority.test.mjs && node components/dashboard/dashboard-style.test.mjs",
        "test": "pnpm run test:auth-security && pnpm run test:password && pnpm run test:import && pnpm run test:dashboard",
        "test:login": "node scripts/login-test.js",
        "backfill:tags": "tsx scripts/backfill-tags.ts",
        "backfill:avatars": "tsx scripts/backfill-user-avatars.ts",
        "diagnose:tags": "tsx scripts/diagnose-tags.ts",
        "admin:promote": "tsx scripts/promote-admin.ts",
        "admin:reset": "tsx scripts/reset-to-admin.ts",
        "admin:users": "tsx scripts/view-users.ts"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@huggingface/transformers": "^4.2.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-context-menu": "^2.2.16",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tanstack/react-query": "^5.90.21",
        "@tanstack/react-table": "^8.21.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "currency.js": "^2.0.4",
        "date-fns": "^4.1.0",
        "exceljs": "^4.4.0",
        "framer-motion": "^12.23.26",
        "geist": "^1.7.1",
        "input-otp": "^1.4.2",
        "lucide-react": "^0.555.0",
        "next": "16.2.6",
        "otpauth": "^9.5.0",
        "qrcode": "^1.5.4",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "recharts": "^3.5.1",
        "resend": "^6.9.2",
        "server-only": "^0.0.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "^17.2.3",
        "eslint": "^9",
        "eslint-config-next": "16.2.6",
        "prisma": "^7.8.0",
        "tailwindcss": "^4",
        "tsx": "^4.22.3",
        "typescript": "^5"
    },
    "description": "Finance management app built with Next.js.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HilFerr/Argent.git"
    },
    "bugs": {
        "url": "https://github.com/HilFerr/Argent/issues"
    },
    "homepage": "https://github.com/HilFerr/Argent#readme",
    "pnpm": {
        "overrides": {
            "minimatch@<3.1.4": "3.1.4",
            "minimatch@>=9.0.0 <9.0.7": "9.0.9",
            "ajv@<6.14.0": "6.14.0",
            "flatted@<3.4.2": "3.4.2",
            "brace-expansion@<1.1.13": "1.1.13",
            "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
            "picomatch@<2.3.2": "2.3.2",
            "picomatch@>=4.0.0 <4.0.4": "4.0.4",
            "@hono/node-server@<1.19.13": "1.19.13",
            "postcss@<8.5.10": "8.5.14",
            "fast-uri@<3.1.2": "3.1.2",
            "hono@<4.12.18": "4.12.19"
        },
        "onlyBuiltDependencies": [
            "@prisma/engines",
            "onnxruntime-node",
            "prisma",
            "protobufjs",
            "sharp",
            "unrs-resolver"
        ]
    }
}
